[Unit]
Description= Load smmu proxy service
SourcePath=/etc/initscripts/start_smmu_proxy_le
After=smcinvoke.service

[Service]
Type=oneshot
Restart=on-failure
RemainAfterExit=yes
# This service file has no binary and it is to execute the list of commands in <script>.
# Use Script file only when there is NO binary or commands to be executed/ modules to be installed cases.
ExecStart=/sbin/insmod /usr/lib/modules/smmu_proxy.ko
ExecStop=/sbin/rmmod /usr/lib/modules/smmu_proxy.ko

[Install]
WantedBy=multi-user.target
