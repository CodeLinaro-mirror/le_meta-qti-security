[Unit]
Description= Load hibernate_tzdata_mgr dlkm service

[Service]
Restart=on-failure
RemainAfterExit=yes
ExecStart=/sbin/insmod /usr/lib/modules/hibernate_tzdata_mgr.ko
ExecStop=/sbin/rmmod /usr/lib/modules/hibernate_tzdata_mgr.ko

[Install]
WantedBy=multi-user.target
