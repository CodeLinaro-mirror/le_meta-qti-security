[Unit]
Description= Load hdcp_qseecom dlkm service

[Service]
Restart=on-failure
RemainAfterExit=yes
# This service file has no binary and it is to execute the list of commands in <script>.
# Use Script file only when there is NO binary or commands to be executed/ modules to be installed cases.

ExecStart=/sbin/insmod /usr/lib/modules/hdcp_qseecom.ko
ExecStartPre = +/bin/chown -R root:system /sys/class/drm/card0/device/power/control ; /bin/chmod -R 0660 /sys/class/drm/card0/device/power/control
ExecStop=/sbin/rmmod /usr/lib/modules/hdcp_qseecom.ko

[Install]
WantedBy=multi-user.target
