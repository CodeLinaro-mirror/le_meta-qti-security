!#/bin/sh /etc/rc.common

USE_PROCD=1
START=5
STOP=94

start_service() {
	procd_open_instance
	procd_set_param command /sbin/insmod /lib/modules/tz_log.ko
	procd_close_instance
}
stop_service() {
	procd_set_param /sbin/rmmod /lib/modules/tz_log.ko
}
