START=05
STOP=94

USE_PROCD=1
PROCD_DEBUG=1

start_service() {
        procd_open_instance
        procd_set_param command insmod /lib/modules/tz_log.ko
        procd_close_instance
}

stop_service() {
        procd_set_param rmmod tz_log_dlkm
}
